{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed envelope shape (informative; does not verify signatures)",
  "type": "object",
  "required": [
    "kind",
    "kid",
    "payload",
    "signature"
  ],
  "properties": {
    "kind": {
      "enum": [
        "MISSION",
        "DELEGATE",
        "INVOKE",
        "PREPARED",
        "APPROVE",
        "DISPATCH",
        "RECEIPT",
        "REVOKE"
      ]
    },
    "kid": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "additionalProperties": false
}
