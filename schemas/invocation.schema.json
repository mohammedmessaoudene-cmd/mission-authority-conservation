{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invocation shape (informative; canonical and semantic checks are additional)",
  "type": "object",
  "required": [
    "iid",
    "mission",
    "cap",
    "actor",
    "aud",
    "op",
    "target",
    "policy",
    "params",
    "deadline"
  ],
  "properties": {
    "iid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x00-\\x7F]+$"
    },
    "mission": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x00-\\x7F]+$"
    },
    "cap": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x00-\\x7F]+$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x00-\\x7F]+$"
    },
    "aud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x00-\\x7F]+$"
    },
    "op": {
      "enum": [
        "pay",
        "send",
        "export"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x00-\\x7F]+$"
    },
    "policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x00-\\x7F]+$"
    },
    "params": {
      "type": "object"
    },
    "deadline": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false
}
